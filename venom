local function noxaRepairKeybinds()
    local defaults = {
        Carry = Enum.KeyCode.Q,
        Lagger = Enum.KeyCode.R,
        AutoLeft = Enum.KeyCode.Z,
        AutoRight = Enum.KeyCode.C,
        AutoPlay = Enum.KeyCode.X,
        BatAimbot = Enum.KeyCode.E,
        TPBat = Enum.KeyCode.V,
    }
    SpeedSystem.keybinds = SpeedSystem.keybinds or {}
    for id, def in pairs(defaults) do
        local k = SpeedSystem.keybinds[id]
        if k == Enum.KeyCode.Unknown then
            SpeedSystem.keybinds[id] = def
        end
    end
    if SpeedSystem.dropBrainrotKeybind == Enum.KeyCode.Unknown then
        SpeedSystem.dropBrainrotKeybind = Enum.KeyCode.G
    end
    if SpeedSystem.tpDownKeybind == Enum.KeyCode.Unknown then
        SpeedSystem.tpDownKeybind = Enum.KeyCode.F
    end
    if SpeedSystem.instantResetKeybind == Enum.KeyCode.Unknown then
        SpeedSystem.instantResetKeybind = Enum.KeyCode.R
    end
end

