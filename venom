-- Trouve l'outil de mêlée équipé (ou dans le backpack)
function SpeedSystem:_tpBatGetMeleeTool()
    local char = LP.Character
    if not char then return nil end
    for _, tool in ipairs(char:GetChildren()) do
        if tool:IsA("Tool") then
            local n = tool.Name:lower()
            if n:find("bat") or n:find("sword") or n:find("knife")
            or n:find("blade") or n:find("mace") then
                return tool
            end
            if tool:FindFirstChildWhichIsA("RemoteEvent")
            or tool:FindFirstChild("Activate") then
                return tool
            end
        end
    end
    -- Cherche dans le backpack et équipe si trouvé
    local bp = LP:FindFirstChild("Backpack")
    if bp then
        for _, tool in ipairs(bp:GetChildren()) do
            if tool:IsA("Tool") then
                local n = tool.Name:lower()
                if n:find("bat") or n:find("sword") or n:find("knife")
                or n:find("blade") or n:find("mace") then
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    if hum then pcall(function() hum:EquipTool(tool) end) end
                    return tool
                end
            end
        end
    end
    return nil
end

-- Swing le bat sur la cible courante
function SpeedSystem:_tpBatTryHit()
    if self.tpBatHittingCooldown then return end
    self.tpBatHittingCooldown = true
    pcall(function()
        local tool = self:_tpBatGetMeleeTool()
        if tool then
            tool:Activate()
            -- Tente de fire le RemoteEvent avec la position cible pour le desync
            local ev = tool:FindFirstChildWhichIsA("RemoteEvent")
            if ev and self.tpBatCurrentTarget and self.tpBatCurrentTarget.Character then
                local tr = self.tpBatCurrentTarget.Character:FindFirstChild("HumanoidRootPart")
                if tr then pcall(function() ev:FireServer(tr.Position) end) end
            end
            if ev then pcall(function() ev:FireServer() end) end
        end
    end)
    task.delay(self.tpBatSwingCooldown, function()
        self.tpBatHittingCooldown = false
    end)
end

-- Trouve le joueur le plus proche
function SpeedSystem:_tpBatGetClosestPlayer(hrp)
    if not hrp then return nil, math.huge end
    local cp, cd = nil, math.huge
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LP and p.Character then
            local tr = p.Character:FindFirstChild("HumanoidRootPart")
            if tr then
                local d = (hrp.Position - tr.Position).Magnitude
                if d < cd then cd = d; cp = p end
            end
        end
    end
    return cp, cd
end

function SpeedSystem:startAntiDesyncAimbot()
    if self._tpBatConn then return end
    self._tpBatConn = RunService.Heartbeat:Connect(function()
        if not self.antiDesyncAimbotEnabled then return end

        local char = LP.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum or hum.Health <= 0 then return end

        local target, _ = self:_tpBatGetClosestPlayer(hrp)
        self.tpBatCurrentTarget = target
        if not target then return end

        local tChar = target.Character
        local tr = tChar and tChar:FindFirstChild("HumanoidRootPart")
        local tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")
        if not tr then return end

        -- Auto-off when enemy is ragdolled
        if tHum then
            local st = tHum:GetState()
            if st == Enum.HumanoidStateType.Physics
                or st == Enum.HumanoidStateType.Ragdoll
                or st == Enum.HumanoidStateType.FallingDown
                or tHum.PlatformStand == true
                or tHum.Health <= 0 then
                self.antiDesyncAimbotEnabled = false
                self:stopAntiDesyncAimbot()
                pcall(function()
                    if self.onUIUpdate then self:onUIUpdate() end
                end)
                return
            end
        end

        -- Desync hidden property (exploits uniquement)
        if sethiddenproperty then
            pcall(function() sethiddenproperty(hrp, "PhysicsRepRootPart", tr) end)
        end

        local targetPos = tr.Position + Vector3.new(0, 0.9, 0)
        local distance  = (hrp.Position - targetPos).Magnitude

        if distance > self.tpBatTeleportDistance then
            -- Téléportation directe (desync jump)
            hrp.CFrame = CFrame.new(targetPos)
            hrp.Velocity = Vector3.zero
        else
            -- Mouvement velocity desync (fluide)
            local dir = (targetPos - hrp.Position).Unit
            hrp.Velocity = dir * self.tpBatVelocitySpeed
        end

        -- Camera lock
        if self.tpBatCameraLock then
            local cam = workspace.CurrentCamera
            if cam then
                pcall(function()
                    cam.CFrame = CFrame.new(cam.CFrame.Position, tr.Position)
                end)
            end
        end

        -- Auto-swing quand assez proche
        if distance < 10 then
            self:_tpBatTryHit()
        end
    end)
end

function SpeedSystem:stopAntiDesyncAimbot()
    if self._tpBatConn then
        self._tpBatConn:Disconnect()
        self._tpBatConn = nil
    end
    self.tpBatCurrentTarget  = nil
    self.tpBatHittingCooldown = false
end

