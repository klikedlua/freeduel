        Position = UDim2.new(0, 2, 0, 2), Size = UDim2.new(1, -4, 0, 4),
        BackgroundColor3 = WHITE, BackgroundTransparency = 0.72,
        BorderSizePixel = 0, ZIndex = 7, Parent = knob,
