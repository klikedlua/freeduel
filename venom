-- ── Sérialisation générique ───────────────────────────────────────────
function NoxaCfg.serialize(value, depth)
    depth = depth or 0
    local t = typeof(value)
    if t == "number" then
        if value ~= value or value == math.huge or value == -math.huge then return nil end
        return value
    elseif t == "boolean" or t == "string" then
        return value
    elseif t == "EnumItem" then
        return { __enum = tostring(value.EnumType):gsub("^Enum%.", ""), __name = value.Name }
    elseif t == "Color3" then
        return { __color3 = true, r = value.R, g = value.G, b = value.B }
    elseif t == "UDim2" then
        return { __udim2 = true, xs = value.X.Scale, xo = value.X.Offset, ys = value.Y.Scale, yo = value.Y.Offset }
    elseif t == "table" and depth < 4 then
        local out, has = {}, false
        for k, v in pairs(value) do
            if type(k) == "string" and k:sub(1, 1) ~= "_" then
                local s = NoxaCfg.serialize(v, depth + 1)
                if s ~= nil then out[k] = s; has = true end
            end
        end
        if has then return out end
        return nil
    end
    return nil
end

function NoxaCfg.deserialize(saved, current)
    local t = typeof(saved)
    if t == "table" then
        if saved.__enum and saved.__name then
            local ok, item = pcall(function() return Enum[saved.__enum][saved.__name] end)
            return (ok and item) or current
        elseif saved.__color3 then
            return Color3.new(tonumber(saved.r) or 0, tonumber(saved.g) or 0, tonumber(saved.b) or 0)
        elseif saved.__udim2 then
            return UDim2.new(tonumber(saved.xs) or 0, tonumber(saved.xo) or 0,
                             tonumber(saved.ys) or 0, tonumber(saved.yo) or 0)
        elseif type(current) == "table" then
            for k, v in pairs(saved) do
                if type(k) == "string" and k:sub(1, 1) ~= "_" then
                    current[k] = NoxaCfg.deserialize(v, current[k])
                end
            end
            return current
        end
        return current
    elseif t == "number" or t == "boolean" or t == "string" then
        if current == nil or typeof(current) == t then return saved end
        if typeof(current) == "EnumItem" and t == "string" and Enum.KeyCode[saved] then
            return Enum.KeyCode[saved]
        end
        return current
    end
    return current
end

