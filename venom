local PROPS = {"BackgroundColor3","TextColor3","ImageColor3","Color","ScrollBarImageColor3"}
local _orig = setmetatable({}, {__mode="k"})   -- mémorise la couleur d'origine

local function remap(inst, prop, t)
    local ok, cur = pcall(function() return inst[prop] end)
    if not ok or cur == nil then return end
    local store = _orig[inst]
    if not store then store = {}; _orig[inst] = store end

    if typeof(cur) == "Color3" then
        local base = store[prop] or cur
        store[prop] = base
        local fn = ROLE[ckey(base)]
        if fn then pcall(function() inst[prop] = fn(t) end) end
    elseif typeof(cur) == "ColorSequence" then
        local base = store[prop] or cur
        store[prop] = base
        local kps, changed = {}, false
        for _, kp in ipairs(base.Keypoints) do
            local fn = ROLE[ckey(kp.Value)]
            if fn then changed = true end
            table.insert(kps, ColorSequenceKeypoint.new(kp.Time, fn and fn(t) or kp.Value))
        end
        if changed then pcall(function() inst[prop] = ColorSequence.new(kps) end) end
    end
end

local CurrentTheme = THEMES[1]

local function applyTheme(t)
    if type(t) ~= "table" or not t.accent then return end
    CurrentTheme = t
    ACCENT       = t.accent
    FX.A2        = t.a2 or lighten(t.accent, 0.35)
    FX.AD        = t.ad or darken(t.accent, 0.45)
    TOGGLE_ON    = t.accent
    TEXT_SECTION = lighten(t.accent, 0.45)
    FX.SEQ = ColorSequence.new({
        ColorSequenceKeypoint.new(0,   FX.AD),
        ColorSequenceKeypoint.new(0.5, ACCENT),
        ColorSequenceKeypoint.new(1,   FX.A2),
    })
    local root = PlayerGui:FindFirstChild("NoxaHub")
    if root then
        for _, d in ipairs(root:GetDescendants()) do
            -- skip text labels that are pure white / pure black (évite couleurs chelou)
            for _, prop in ipairs(PROPS) do
                pcall(function() remap(d, prop, t) end)
            end
        end
    end
    for i = #AccentRegistry, 1, -1 do
        local e = AccentRegistry[i]
        if not e.inst or not e.inst.Parent then
            table.remove(AccentRegistry, i)
        else
            pcall(function() e.inst[e.prop] = ACCENT end)
        end
    end
    pcall(function()
        local bb = _G.NoxaBillboard
        if bb then
            if bb.dc then bb.dc.TextColor3 = ACCENT end
            if bb.speed then bb.speed.TextColor3 = ACCENT end
            if bb.ul then bb.ul.BackgroundColor3 = ACCENT end
        end
    end)
    pcall(function()
        if NoxaESP then
            NoxaESP.boxColor = ACCENT
            NoxaESP.tracerColor = FX.A2
        end
    end)
    pcall(function()
        if SpeedSystem and not SpeedSystem.introColorLocked then
            SpeedSystem.introColor = ACCENT
        end
        if _G.NoxaIntroLetters then
            for _, lbl in ipairs(_G.NoxaIntroLetters) do
                if lbl and lbl.Parent then lbl.TextColor3 = ACCENT end
            end
        end
    end)
end

local function resetThemeColors()
    -- clear remap memory so next apply is clean
    for k in pairs(_orig) do _orig[k] = nil end
    applyTheme(THEMES[1])
    pcall(function() if notify then notify("Couleurs reset · Chrome", 2) end end)
end
_G.NoxaResetThemeColors = resetThemeColors

