-- ── Keybinds (fichier séparé, format Ace : string) ────────────────────
function NoxaCfg.keyToString(key)
    if typeof(key) ~= "EnumItem" then return "None" end
    return tostring(key):gsub("Enum%.KeyCode%.", "")
end
function NoxaCfg.stringToKey(value)
    if type(value) ~= "string" or value == "" or value == "None" then return nil end
    local ok, key = pcall(function() return Enum.KeyCode[value] end)
    return ok and key or nil
end

function NoxaCfg.collectKeybinds()
    local out = {}
    for id, key in pairs(SpeedSystem.keybinds or {}) do
        out[id] = NoxaCfg.keyToString(key)
    end
    local extra = {}
    for _, id in ipairs({ "dropBrainrotKeybind", "tpDownKeybind", "instantResetKeybind" }) do
        if SpeedSystem[id] ~= nil then extra[id] = NoxaCfg.keyToString(SpeedSystem[id]) end
    end
    return { keybinds = out, single = extra }
end

function NoxaCfg.applyKeybinds(data)
    if type(data) ~= "table" then return end
    if type(data.keybinds) == "table" and type(SpeedSystem.keybinds) == "table" then
        for id, name in pairs(data.keybinds) do
            if name == "None" or name == "" or name == nil then
                SpeedSystem.keybinds[id] = nil
            else
                local key = NoxaCfg.stringToKey(name)
                if key then SpeedSystem.keybinds[id] = key end
            end
        end
    end
    if type(data.single) == "table" then
        for id, name in pairs(data.single) do
            if name == "None" or name == "" or name == nil then
                SpeedSystem[id] = nil
            else
                local key = NoxaCfg.stringToKey(name)
                if key then SpeedSystem[id] = key end
            end
        end
    end
end

-- ── Collecte / application ────────────────────────────────────────────
function NoxaCfg.collect()
    local sys = {}
    for k, v in pairs(SpeedSystem) do
        if type(k) == "string" and k:sub(1, 1) ~= "_" and not NoxaCfg.blocked[k] then
            local s = NoxaCfg.serialize(v)
            if s ~= nil then sys[k] = s end
        end
    end
    local extra = {}
    for name, def in pairs(NoxaCfg.extras) do
        local ok, val = pcall(def.get)
        if ok then
            local s = NoxaCfg.serialize(val)
            if s ~= nil then extra[name] = s end
        end
    end
    return { __version = 3, sys = sys, extra = extra, keys = NoxaCfg.collectKeybinds() }
end

function NoxaCfg.applyExtras(data)
    if type(data) == "table" and type(data.extra) == "table" then
        for name, val in pairs(data.extra) do
            local def = NoxaCfg.extras[name]
            if def and def.set then pcall(def.set, NoxaCfg.deserialize(val, nil)) end
        end
    end
end

function NoxaCfg.apply(data)
    if type(data) ~= "table" then return end

    -- Compatibilité avec les anciennes configs (v1)
    if data.sys == nil then
        for k, v in pairs({ normalSpeed = "NS", carrySpeed = "CS",
                            laggerNormal = "LAGGER_NORMAL", laggerCarry = "LAGGER_CARRY" }) do
            if type(data[k]) == "number" then SpeedSystem[v] = data[k] end
        end
        for k, v in pairs(data) do
            if SpeedSystem[k] ~= nil and typeof(SpeedSystem[k]) == typeof(v) then SpeedSystem[k] = v end
        end
        if type(data.keybinds) == "table" then
            for k, name in pairs(data.keybinds) do
                local key = NoxaCfg.stringToKey(name)
                if key then SpeedSystem.keybinds[k] = key end
            end
        end
        for _, key in ipairs({ "dropBrainrotKeybind", "tpDownKeybind", "instantResetKeybind" }) do
            local k = NoxaCfg.stringToKey(data[key])
            if k then SpeedSystem[key] = k end
        end
        return
    end

    for k, v in pairs(data.sys) do
        if type(k) == "string" and k:sub(1, 1) ~= "_" and not NoxaCfg.blocked[k] then
            local newVal = NoxaCfg.deserialize(v, SpeedSystem[k])
            if newVal ~= nil then SpeedSystem[k] = newVal end
        end
    end
    NoxaCfg.applyKeybinds(data.keys)
    NoxaCfg.applyExtras(data)
end

