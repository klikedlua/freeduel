-- Helper local : met à jour un toggle row depuis son état booléen
local function syncToggleRow(row, state)
    if not row then return end
    ToggleStates[row] = state and true or false
    local area = row:FindFirstChild("ToggleArea")
    if not area then return end
    local track = area:FindFirstChildWhichIsA("Frame")
    if not track then return end
    local knob = track:FindFirstChildWhichIsA("Frame")
    if knob then setToggleVisual(track, knob, state and true or false) end
end

-- Appelée après loadConfig pour que l'UI reflète les valeurs chargées
function refreshUIFromConfig()
    -- TextBoxes de vitesse
    if nsBox then nsBox.Text = tostring(SpeedSystem.NS) end
    if csBox then csBox.Text = tostring(SpeedSystem.CS) end
    if lsBox then lsBox.Text = tostring(SpeedSystem.LAGGER_NORMAL) end
    if lcBox then lcBox.Text = tostring(SpeedSystem.LAGGER_CARRY) end

    -- Toggles Movement
    syncToggleRow(autoCarryRow,  SpeedSystem.autoCarryEnabled)
    syncToggleRow(infJumpRow,    SpeedSystem.infJumpEnabled)
    syncToggleRow(antiRagRow,    SpeedSystem.antiRagdollEnabled)

    -- Keybind labels dynamiques
    if dropLabel then
        dropLabel.Text = "Drop Brainrot  [" .. SpeedSystem.dropBrainrotKeybind.Name .. "]"
    end
    if tpDownLabel then
        tpDownLabel.Text = "TP Down  [" .. SpeedSystem.tpDownKeybind.Name .. "]"
    end
    if resetLabel then
        resetLabel.Text = "Instant Reset  [" .. SpeedSystem.instantResetKeybind.Name .. "]"
    end

    -- Toggles Combat
    syncToggleRow(batCounterRow,     NoxaMods.batCounterEnabled)
    syncToggleRow(medusaCounterRow,  NoxaMods.medusaCounterEnabled)
    do
        local rows = _G.NoxaBatCounterModeRows
        if rows and rows.setRowState then
            local cur = NoxaMods.batCounterMode or "V1"
            rows.setRowState(rows.v1, cur == "V1")
            rows.setRowState(rows.v2, cur == "V2")
            rows.setRowState(rows.v3, cur == "V3")
        end
    end

    -- Toggles Utility
    syncToggleRow(antiLagRow,  NoxaMods.antiLagEnabled)
    syncToggleRow(nukeOptRow,  NoxaMods.nukeEnabled)
    syncToggleRow(_G.NoxaAntiKickRow, SpeedSystem.antiKickEnabled)

    -- Mode visuel steal
    updateModeVisual()

    -- Applique l'état logique chargé
    SpeedSystem:setInfJumpEnabled(SpeedSystem.infJumpEnabled)
    SpeedSystem:setAntiRagdoll(SpeedSystem.antiRagdollEnabled)
    if NoxaMods.antiLagEnabled then NoxaMods:enableAntiLag() end
    if NoxaMods.nukeEnabled then _G._nukeStart() end
    if SpeedSystem.antiKickEnabled then SpeedSystem:enableAntiKick() end
    if NoxaMods.batCounterEnabled then NoxaMods:startBatCounter() end
    if NoxaMods.medusaCounterEnabled then NoxaMods:setupMedusaCounter(LP.Character) end
    if SpeedSystem.autoStealEnabled then startAutoSteal() end
end

SpeedSystem.onUIUpdate = function()
    local function _sync(row, state)
        if not row then return end
        local area = row:FindFirstChild("ToggleArea")
        if not area then return end
        local track = area:FindFirstChildWhichIsA("Frame")
        if not track then return end
        local knob = track:FindFirstChildWhichIsA("Frame")
        if track and knob then setToggleVisual(track, knob, state and true or false) end
    end
    _sync(carryToggleRow, SpeedSystem.carryActive)
    _sync(laggerToggleRow, SpeedSystem.laggerActive)
    _sync(antiDesyncToggleRow, SpeedSystem.antiDesyncAimbotEnabled)
end

