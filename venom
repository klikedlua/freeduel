local function saveConfig(force)
    local function resolveWrite()
        local candidates = {}
        local g = (type(getgenv) == "function" and getgenv()) or {}
        pcall(function() table.insert(candidates, writefile) end)
        pcall(function() table.insert(candidates, g.writefile) end)
        pcall(function() table.insert(candidates, syn and syn.writefile) end)
        pcall(function() table.insert(candidates, fluxus and fluxus.writefile) end)
        pcall(function() table.insert(candidates, _G.writefile) end)
        pcall(function()
            if typeof(getrenv) == "function" then
                local r = getrenv()
                if r then table.insert(candidates, r.writefile) end
            end
        end)
        for _, fn in ipairs(candidates) do
            if type(fn) == "function" then return fn end
        end
        return nil
    end

    local wf = resolveWrite()
    if not wf then
        warn("[Noxa] SAVE FAIL: no writefile on this executor")
        return false, "no_writefile"
    end

    local ok, err = pcall(function()
        pcall(noxaRepairKeybinds)
        local cfg = {
            version = "noxa_v16",
            NS = tonumber(SpeedSystem.NS) or 59.5,
            CS = tonumber(SpeedSystem.CS) or 28.8,
            LAGGER_NORMAL = tonumber(SpeedSystem.LAGGER_NORMAL) or 15,
            LAGGER_CARRY = tonumber(SpeedSystem.LAGGER_CARRY) or 24.5,
            carryActive = SpeedSystem.carryActive == true,
            laggerActive = SpeedSystem.laggerActive == true,
            autoCarryEnabled = SpeedSystem.autoCarryEnabled == true,
            autoPlayMode = tostring(SpeedSystem.autoPlayMode or "2btn"),
            autoPlayEnabled = SpeedSystem.autoPlayEnabled == true,
            autoPlayAfterCooldown = SpeedSystem.autoPlayAfterCooldown == true,
            introEnabled = SpeedSystem.introEnabled ~= false,
            uiScale = tonumber(SpeedSystem.uiScale) or 0.75,
            menuOpen = SpeedSystem.menuOpen ~= false,
            infJumpEnabled = SpeedSystem.infJumpEnabled == true,
            antiRagdollEnabled = SpeedSystem.antiRagdollEnabled == true,
            antiDesyncAimbotEnabled = SpeedSystem.antiDesyncAimbotEnabled == true,
            stealRadius = tonumber(SpeedSystem.stealRadius) or 60,
            stealDuration = tonumber(SpeedSystem.stealDuration) or 1.3,
            stealMode = tostring(SpeedSystem.stealMode or "V1"),
            autoStealEnabled = SpeedSystem.autoStealEnabled == true,
            antiKickEnabled = SpeedSystem.antiKickEnabled == true,
            keys = {},
        }
        if type(SpeedSystem.keybinds) == "table" then
            for id, key in pairs(SpeedSystem.keybinds) do
                if typeof(key) == "EnumItem" then cfg.keys[tostring(id)] = key.Name end
            end
        end
        for _, id in ipairs({"dropBrainrotKeybind", "tpDownKeybind", "instantResetKeybind"}) do
            local key = SpeedSystem[id]
            if typeof(key) == "EnumItem" then cfg.keys[id] = key.Name end
        end

        local json = game:GetService("HttpService"):JSONEncode(cfg)
        if type(json) ~= "string" or #json < 5 then error("json fail") end
        if not force and NoxaCfg.lastJson == json then return end
        NoxaCfg.lastJson = json

        local paths = {
            "NoxaHub.json",
            "NoxaDuels_Config.json",
            "NoxaVynx_MainGUI_Config.json",
            "noxa_config.json",
        }
        local wrote = false
        local lastE = nil
        for _, pth in ipairs(paths) do
            local okw, e = pcall(wf, pth, json)
            if okw then wrote = true else lastE = e end
        end
        if not wrote then error(tostring(lastE or "write failed")) end
    end)
    if not ok then
        warn("[Noxa] saveConfig fail:", err)
        return false, tostring(err)
    end
    return true, "ok"
end
_G.NoxaSaveConfig = function() return saveConfig(true) end

local function loadConfig()
    local wf, rf, isf = NoxaCfg.env()
    if type(rf) ~= "function" then return end
    local data = nil
    for _, path in ipairs(CONFIG_FALLBACKS) do
        local ok, decoded = pcall(function()
            if type(isf) == "function" and not isf(path) then return nil end
            local raw = rf(path)
            if type(raw) ~= "string" or raw == "" then return nil end
            return NoxaCfg.http:JSONDecode(raw)
        end)
        if ok and type(decoded) == "table" then
            data = decoded
            break
        end
    end
    if type(data) ~= "table" then return end
    -- keybinds fichier séparé
    pcall(function()
        for _, path in ipairs(KEYBINDS_FALLBACKS) do
            if type(isf) ~= "function" or isf(path) then
                local ok, kb = pcall(function() return NoxaCfg.http:JSONDecode(rf(path)) end)
                if ok and type(kb) == "table" then
                    data.keys = kb
                    break
                end
            end
        end
    end)
    NoxaCfg.pending = data
    NoxaCfg.apply(data)
    -- appliquer champs explicites Ace-style (priorité)
    local function num(v, d) return tonumber(v) or d end
    if data.NS then SpeedSystem.NS = num(data.NS, SpeedSystem.NS) end
    if data.CS then SpeedSystem.CS = num(data.CS, SpeedSystem.CS) end
    if data.LAGGER_NORMAL then SpeedSystem.LAGGER_NORMAL = num(data.LAGGER_NORMAL, SpeedSystem.LAGGER_NORMAL) end
    if data.LAGGER_CARRY then SpeedSystem.LAGGER_CARRY = num(data.LAGGER_CARRY, SpeedSystem.LAGGER_CARRY) end
    if data.carryActive ~= nil then SpeedSystem.carryActive = data.carryActive == true end
    if data.laggerActive ~= nil then SpeedSystem.laggerActive = data.laggerActive == true end
    if data.autoCarryEnabled ~= nil then SpeedSystem.autoCarryEnabled = data.autoCarryEnabled == true end
    SpeedSystem.safeModeEnabled = false -- removed
    if data.autoPlayMode == "1btn" or data.autoPlayMode == "2btn" then SpeedSystem.autoPlayMode = data.autoPlayMode end
    if data.antiDesyncAimbotEnabled ~= nil then SpeedSystem.antiDesyncAimbotEnabled = data.antiDesyncAimbotEnabled == true end
    if data.infJumpEnabled ~= nil then SpeedSystem.infJumpEnabled = data.infJumpEnabled == true end
    if data.antiRagdollEnabled ~= nil then SpeedSystem.antiRagdollEnabled = data.antiRagdollEnabled == true end
    if data.antiKickEnabled ~= nil then SpeedSystem.antiKickEnabled = data.antiKickEnabled == true end
    if data.uiScale then SpeedSystem.uiScale = num(data.uiScale, SpeedSystem.uiScale) end
    if type(data.tabPos) == "string" then SpeedSystem.tabPos = data.tabPos end
    if type(data.animPack) == "string" then SpeedSystem.animPack = data.animPack end
    if type(data.mobileButtons) == "table" then
        for k, v in pairs(data.mobileButtons) do SpeedSystem.mobileButtons[k] = v end
    end
    noxaRepairKeybinds()
end
_G.NoxaLoadConfig = loadConfig

