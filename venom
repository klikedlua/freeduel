mkSection(P_UTILITY,"PROTECTION")

do
    SpeedSystem.antiKickEnabled  = SpeedSystem.antiKickEnabled == true
    SpeedSystem.brainrotDetected = false

    -- ── Moteur Anti-Kick (repris de Vynx, adapté Noxa) ────────────────
    function SpeedSystem:enableAntiKick()
        if self._antiKickRunning then self.antiKickEnabled = true return end
        self.antiKickEnabled  = true
        self._antiKickRunning = true

        -- 1) Blocage direct de LocalPlayer:Kick() si l'executor le permet
        if not self._antiKickHooked then
            self._antiKickHooked = true
            pcall(function()
                local hookf = hookfunction or (syn and syn.hookfunction)
                if type(hookf) == "function" then
                    local old
                    old = hookf(Instance.new("Player").Kick, function(inst, ...)
                        if SpeedSystem.antiKickEnabled and inst == LP then return end
                        return old(inst, ...)
                    end)
                end
            end)
            pcall(function()
                local hookmeta = hookmetamethod
                if type(hookmeta) == "function" then
                    local oldNC
                    oldNC = hookmeta(game, "__namecall", function(self2, ...)
                        local method = getnamecallmethod and getnamecallmethod() or ""
                        if SpeedSystem.antiKickEnabled and method == "Kick" and self2 == LP then
                            return nil
                        end
                        return oldNC(self2, ...)
                    end)
                end
            end)
        end

        -- 2) Détection brainrot (logique Vynx)
        task.spawn(function()
            while SpeedSystem.antiKickEnabled do
                task.wait(0.5)
                local char = LP.Character
                if char then
                    local found = false
                    for _, tool in ipairs(char:GetChildren()) do
                        if tool:IsA("Tool") then
                            local n = tool.Name:lower()
                            if n:find("brainrot") or n:find("skibidi") or n:find("toilet") then
                                found = true
                                break
                            end
                        end
                    end
                    SpeedSystem.brainrotDetected = found
                end
            end
            SpeedSystem._antiKickRunning = false
        end)
    end

    function SpeedSystem:disableAntiKick()
        self.antiKickEnabled  = false
        self.brainrotDetected = false
    end

    function SpeedSystem:setAntiKick(on)
        if on then self:enableAntiKick() else self:disableAntiKick() end
        saveConfig(true)
    end

    -- ── Toggle UI ─────────────────────────────────────────────────────
    local akRow = mkToggle(P_UTILITY, "Anti-Kick", SpeedSystem.antiKickEnabled, false)
    _G.NoxaAntiKickRow = akRow
    if akRow then
        local area = akRow:FindFirstChild("ToggleArea")
        local tc   = area and area:FindFirstChild("ToggleClick")
        if tc then
            tc.MouseButton1Click:Connect(function()
                SpeedSystem:setAntiKick(not SpeedSystem.antiKickEnabled)
            end)
        end
    end

    registerConfigExtra("antiKickEnabled",
        function() return SpeedSystem.antiKickEnabled == true end,
        function(v) SpeedSystem.antiKickEnabled = v == true end)
end

