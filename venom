local function mixC(a, b, t) return a:Lerp(b, t) end
local function lighten(c, t) return mixC(c, Color3.fromRGB(255,255,255), t) end
local function darken(c, t)  return mixC(c, Color3.fromRGB(0,0,0), t) end

local function ckey(c)
    return string.format("%d,%d,%d",
        math.floor(c.R*255+0.5), math.floor(c.G*255+0.5), math.floor(c.B*255+0.5))
end

