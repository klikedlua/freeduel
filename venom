        Padding = UDim.new(0, 6),
        SortOrder = Enum.SortOrder.LayoutOrder, Parent = card,
    })
    new("UIPadding", {
        PaddingTop = UDim.new(0, 9), PaddingBottom = UDim.new(0, 9),
        PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8),
        Parent = card,
    })

    -- En-tête "— SUB OPTIONS"
    do
        local head = new("Frame", {
            Size = UDim2.new(1, -4, 0, 16),
            BackgroundTransparency = 1, Parent = card,
        })
        local dash = new("Frame", {
            Position = UDim2.new(0, 0, 0.5, -1), Size = UDim2.new(0, 14, 0, 2),
            BackgroundColor3 = ACCENT, BackgroundTransparency = 0.25,
            BorderSizePixel = 0, Parent = head,
        })
        corner(dash, 1); regAccent(dash)
        new("TextLabel", {
            Position = UDim2.new(0, 20, 0, 0), Size = UDim2.new(1, -20, 1, 0),
            BackgroundTransparency = 1, Text = "SUB OPTIONS",
            TextColor3 = TEXT_DIM, TextSize = 10,
            Font = Enum.Font.GothamBlack,
            TextXAlignment = Enum.TextXAlignment.Left, Parent = head,
        })
    end

    -- Toggles V1 / V2 Semi / V3 mutuellement exclusifs
    local modeRows = {}
    local applyingMode = false

    -- Retrouve le track + knob d'un row (les instances n'ont pas de nom
    -- explicite dans mkToggle, il faut donc les chercher par type).
    local function rowParts(r)
        local area = r and r:FindFirstChild("ToggleArea")
        if not area then return nil, nil end
        local track
        for _, c in ipairs(area:GetChildren()) do
            if c:IsA("Frame") then track = c break end
        end
        if not track then return nil, nil end
        local knob
        for _, c in ipairs(track:GetChildren()) do
            if c:IsA("Frame") then knob = c break end
        end
        return track, knob
    end

    local function setRowState(r, state)
        if not r then return end
        ToggleStates[r] = state and true or false
        local track, knob = rowParts(r)
        if track and knob then
            setToggleVisual(track, knob, state and true or false)
        end
    end

    local function selectMode(mode, activeRow)
        if applyingMode then return end
        applyingMode = true
        setMode(mode)
        for _, r in ipairs(modeRows) do
            setRowState(r, r == activeRow)
        end
        applyingMode = false
        -- Relance proprement l'auto grab pour prendre le nouveau mode
        if SpeedSystem.autoStealEnabled then
            pcall(stopAutoSteal)
            task.defer(function()
                if SpeedSystem.autoStealEnabled then pcall(startAutoSteal) end
            end)
        end
    end

    local function mkModeRow(name, mode)
        local row = mkToggle(card, name, SpeedSystem.stealMode == mode)
        table.insert(modeRows, row)
        wire(row, function(v)
            if applyingMode then return end
            if v then
                selectMode(mode, row)
            else
                -- Un mode doit toujours rester actif : on ré-active celui-ci
                setRowState(row, true)
            end
        end)
        return row
    end

    local v1Row = mkModeRow("V1", "V1")
    local v2Row = mkModeRow("V2 Semi", "V2 SEMI")
    local v3Row = mkModeRow("V3", "V3")

    -- État initial cohérent (un seul actif)
    do
        local cur = SpeedSystem.stealMode
        local activeRow = (cur == "V2 SEMI" and v2Row) or (cur == "V3" and v3Row) or v1Row
        applyingMode = true
        setMode((cur == "V2 SEMI" or cur == "V3") and cur or "V1")
        for _, r in ipairs(modeRows) do setRowState(r, r == activeRow) end
        applyingMode = false
    end

    -- Ouverture / fermeture animée
    if grabArrow then
        local open = false
        local FULL = 9 + 16 + 6 + (34 * 3) + (6 * 2) + 9  -- padding + header + 3 rows
        grabArrow.MouseButton1Click:Connect(function()
            open = not open
            if open then
                card.Visible = true
                tw(card, MED, {Size = UDim2.new(1, -4, 0, FULL)})
                tw(grabArrow, FAST, {Rotation = 180})
            else
                tw(grabArrow, FAST, {Rotation = 0})
                tw(card, MED, {Size = UDim2.new(1, -4, 0, 0)})
                task.delay(0.3, function()
                    if not open then card.Visible = false end
                end)
            end
        end)
    end
end

