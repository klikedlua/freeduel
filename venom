--  BOUCLE DE VITESSE PRINCIPALE
-- ═════════════════════════════════════════════════════════════════════

local speedConn = nil
local lastMoveDir = Vector3.new(0, 0, 0)

local function isRagdollState(hum)
    if not hum then return true end
    local st = hum:GetState()
    return hum.PlatformStand or st == Enum.HumanoidStateType.Physics
        or st == Enum.HumanoidStateType.Ragdoll
        or st == Enum.HumanoidStateType.FallingDown
end

function SpeedSystem:startSpeedLoop()
    if speedConn then return end
    
    speedConn = RunService.RenderStepped:Connect(function(dt)
        local char = LP.Character
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hum or not hrp then return end
        
        if isRagdollState(hum) then
            lastMoveDir = Vector3.new(0, 0, 0)
            self:destroySpeedObjects()
            return
        end
        if self._dropBrainrotActive then
            return
        end
        
        local md = hum.MoveDirection
        local spd = self:getActiveSpeed(hum)
        local dir = Vector3.new(0, 0, 0)
        
        if md.Magnitude > 0 then
            lastMoveDir = md
            dir = md
        elseif lastMoveDir.Magnitude > 0 then
            local anyHeld = false
            for key in pairs({W=true,A=true,S=true,D=true, Up=true, Left=true, Down=true, Right=true}) do
                if UserInputService:IsKeyDown(Enum.KeyCode[key]) then anyHeld = true; break end
            end
            if anyHeld then dir = lastMoveDir end
        end
        
        -- Same as Normal Speed path
        if hum.WalkSpeed ~= spd then
            hum.WalkSpeed = spd
        end
        if dir.Magnitude > 0 then
            self:applySpeed(hrp, hum, dir, spd, dt)
        else
            self:destroySpeedObjects()
        end
    end)
end

-- ── KEYBIND HANDLING ───────────────────────────────────────────────────

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
    local key = input.KeyCode
    if key == Enum.KeyCode.Unknown then return end

    if SpeedSystem.keybinds.Carry and key == SpeedSystem.keybinds.Carry then
        SpeedSystem:toggleCarry()
        saveConfig()
    end
    
    if SpeedSystem.keybinds.Lagger and key == SpeedSystem.keybinds.Lagger then
        SpeedSystem:toggleLagger()
        saveConfig()
    end

    if SpeedSystem.dropBrainrotKeybind and key == SpeedSystem.dropBrainrotKeybind then
        local blocked = SpeedSystem:isActionBlocked("drop")
        if blocked then notify("Safe Mode", 1.5) else SpeedSystem:runDropBrainrot() end
    end

    if SpeedSystem.tpDownKeybind and key == SpeedSystem.tpDownKeybind then
        SpeedSystem:runTPDown()
    end

    if SpeedSystem.instantResetKeybind and key == SpeedSystem.instantResetKeybind then
        SpeedSystem:runInstantReset()
    end

    if SpeedSystem.keybinds.TPBat and key == SpeedSystem.keybinds.TPBat then
        local blocked, reason = SpeedSystem:isActionBlocked("tpbat")
        if blocked then
            notify(reason == "countdown" and "Safe Mode · countdown" or "Safe Mode · brainrot", 1.8)
        else
            SpeedSystem.antiDesyncAimbotEnabled = not SpeedSystem.antiDesyncAimbotEnabled
            if SpeedSystem.antiDesyncAimbotEnabled then
                SpeedSystem:startAntiDesyncAimbot()
            else
                SpeedSystem:stopAntiDesyncAimbot()
            end
            SpeedSystem:updateUI()
            saveConfig()
        end
    end
end)

