-- ── AUTO-SAVE : tout paramètre modifié est écrit automatiquement ───────
local function startAutoSave()
    if NoxaCfg.autoSaveStarted then return end
    NoxaCfg.autoSaveStarted = true

    -- clean-style: compare JSON, write only on change (every 0.5s check)
    task.spawn(function()
        while task.wait(0.5) do
            local ok, json = pcall(function()
                return NoxaCfg.http:JSONEncode(NoxaCfg.collectExplicit())
            end)
            if ok and type(json) == "string" and json ~= NoxaCfg.lastJson then
                saveConfig(true)
            end
        end
    end)

    -- safety net every 8s
    task.spawn(function()
        while task.wait(8) do
            saveConfig(true)
        end
    end)

    pcall(function()
        Players.PlayerRemoving:Connect(function(plr)
            if plr == LP then saveConfig(true) end
        end)
    end)
    pcall(function()
        if LP.OnTeleport then
            LP.OnTeleport:Connect(function() saveConfig(true) end)
        end
    end)
    pcall(function()
        LP.CharacterRemoving:Connect(function() saveConfig(true) end)
    end)

    -- create file immediately
    task.spawn(function()
        task.wait(0.4)
        saveConfig(true)
    end)
end

