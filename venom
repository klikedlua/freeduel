        elseif side == "right" then setRowVisual(autoRightRow, false) end
    end

    SpeedSystem.AutoPath.start = function(side)
        SpeedSystem.AutoPath.stop(side == "left" and "right" or "left")
        SpeedSystem.AutoPath.stop(side)
        SpeedSystem.AutoPath[side .. "Enabled"] = true
        SpeedSystem.AutoPath[side .. "Phase"] = 1
        setRowVisual(side == "left" and autoLeftRow or autoRightRow, true)
        local P1 = side == "left" and AP_L1 or AP_R1
        local P2 = side == "left" and AP_L2 or AP_R2
        SpeedSystem.AutoPath[side .. "Conn"] = RunService.Heartbeat:Connect(function()
            if not SpeedSystem.AutoPath[side .. "Enabled"] then return end
            local char = LP.Character
            if not char then return end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            local hum = char:FindFirstChildOfClass("Humanoid")
            if not hrp or not hum then return end
            local st = hum:GetState()
            if hum.PlatformStand or st == Enum.HumanoidStateType.Physics
                or st == Enum.HumanoidStateType.Ragdoll then
                pcall(function() hum:Move(Vector3.new(0,0,0), false) end)
                return
            end
            local spd = pathSpeed()
            if SpeedSystem.AutoPath[side .. "Phase"] == 1 then
                local tgt = Vector3.new(P1.X, hrp.Position.Y, P1.Z)
                if (tgt - hrp.Position).Magnitude < 1 then
                    SpeedSystem.AutoPath[side .. "Phase"] = 2
                    stepTo(hum, hrp, P2, spd)
                    return
                end
                stepTo(hum, hrp, P1, spd)
            else
                local tgt = Vector3.new(P2.X, hrp.Position.Y, P2.Z)
                if (tgt - hrp.Position).Magnitude < 1 then
                    SpeedSystem.AutoPath.stop(side)
                    return
                end
                stepTo(hum, hrp, P2, spd)
            end
        end)
    end

    SpeedSystem.AutoPath.set = function(side, on)
        if on then SpeedSystem.AutoPath.start(side) else SpeedSystem.AutoPath.stop(side) end
    end

    -- ── Auto Play 1 bouton (Irish / plot detect + routes swapped) ────
    local AP_PLOT3_POS = Vector3.new(-476.7524719238281, 10.464664459228516, 7.107429504394531)
    local AP_PLOT7_POS = Vector3.new(-476.7524719238281, 10.464664459228516, 114.10742950439453)
    -- START_A (plot 7) = Right route ; START_B (plot 3) = Left route
    local routes = {
        START_A = {
            StartPoint = Vector3.new(-476.16, -6.52, 25.62),
            Route = { Vector3.new(-483.06, -5.03, 25.48) },
        },
        START_B = {
            StartPoint = Vector3.new(-476.48, -6.28, 92.73),
            Route = { Vector3.new(-483.12, -4.95, 94.80) },
        },
    }
    local detectedSpawn = nil -- 1 = plot3/left , 2 = plot7/right
    local routeRunning, routePhase, routeConn, routeStopCallback = false, 0, nil, nil
    local currentRouteId = 0
    local routePoints = {}

    -- plus de scan plot lourd (bug début de duel) — side = distance aux starts
    local function detectSideFromPos()
        local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        if not hrp then return 2 end
        local dl = (Vector3.new(-476.48, hrp.Position.Y, 92.73) - hrp.Position).Magnitude
        local dr = (Vector3.new(-476.16, hrp.Position.Y, 25.62) - hrp.Position).Magnitude
        return dl <= dr and 1 or 2
    end

    local function startRouteWalk(waypoints, onStop)
        if routeConn then pcall(function() routeConn:Disconnect() end) end
        routePoints = waypoints
        routePhase = 1
        routeRunning = true
        routeStopCallback = onStop
        currentRouteId = currentRouteId + 1
        local myRouteId = currentRouteId
        SpeedSystem.autoPlayEnabled = true
        setRowVisual(autoPlay1Row, true)

        routeConn = RunService.Heartbeat:Connect(function()
            if not routeRunning or myRouteId ~= currentRouteId then
                local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
                if hrp then hrp.AssemblyLinearVelocity = Vector3.new(0, hrp.AssemblyLinearVelocity.Y, 0) end
                if routeConn then routeConn:Disconnect(); routeConn = nil end
                return
            end
            local char = LP.Character
            if not char then return end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            local hum = char:FindFirstChildOfClass("Humanoid")
            if not hrp or not hum then return end
            local st = hum:GetState()
            if hum.PlatformStand or st == Enum.HumanoidStateType.Physics
                or st == Enum.HumanoidStateType.Ragdoll or st == Enum.HumanoidStateType.FallingDown then
                hum:Move(Vector3.zero, false)
                return
            end
            if routePhase > #routePoints then
                hrp.AssemblyLinearVelocity = Vector3.zero
                routeRunning = false
                SpeedSystem.autoPlayEnabled = false
                if routeConn then routeConn:Disconnect(); routeConn = nil end
                setRowVisual(autoPlay1Row, false)
                if routeStopCallback then routeStopCallback(); routeStopCallback = nil end
                pcall(function() if _G.NoxaMobileSyncAutoPlay then _G.NoxaMobileSyncAutoPlay() end end)
                return
            end
            local target = routePoints[routePhase]
            local targetPos = Vector3.new(target.X, hrp.Position.Y, target.Z)
            local dir = Vector3.new(targetPos.X - hrp.Position.X, 0, targetPos.Z - hrp.Position.Z)
            if dir.Magnitude < 1.2 then
                routePhase = routePhase + 1
                hrp.AssemblyLinearVelocity = Vector3.zero
                return
            end
            local speed = pathSpeed()
            if SpeedSystem.carryActive then
                speed = SpeedSystem.laggerActive and SpeedSystem.LAGGER_CARRY or SpeedSystem.CS
            end
            local moveDir = dir.Unit
            hrp.AssemblyLinearVelocity = Vector3.new(moveDir.X * speed, hrp.AssemblyLinearVelocity.Y, moveDir.Z * speed)
            hum:Move(moveDir, false)
            pcall(function() SpeedSystem:applySpeed(hrp, hum, moveDir, speed, 1/60) end)
        end)
    end

    local function stopIrishAutoPlay()
        routeRunning = false
        SpeedSystem.autoPlayEnabled = false
        if routeConn then pcall(function() routeConn:Disconnect() end); routeConn = nil end
        local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        if hrp then hrp.AssemblyLinearVelocity = Vector3.new(0, hrp.AssemblyLinearVelocity.Y, 0) end
        setRowVisual(autoPlay1Row, false)
        pcall(function() if _G.NoxaMobileSyncAutoPlay then _G.NoxaMobileSyncAutoPlay() end end)
    end

    SpeedSystem.AutoPath.setYusf = function(on)
        SpeedSystem.AutoPath.stop("left")
        SpeedSystem.AutoPath.stop("right")
        if not on then
            stopIrishAutoPlay()
            notify("Auto Play · OFF", 1.4)
            saveConfig()
            return
        end
        local blocked, reason = SpeedSystem:isActionBlocked("autoplay")
        if blocked then
            notify(reason == "countdown" and "Safe Mode · countdown" or "Safe Mode · brainrot", 2)
            setRowVisual(autoPlay1Row, false)
            SpeedSystem.autoPlayEnabled = false
            return
        end
        local side = detectSideFromPos()
        local route = (side == 1) and routes.START_B or routes.START_A
        local waypoints = { route.StartPoint }
        for _, p in ipairs(route.Route) do table.insert(waypoints, p) end
        startRouteWalk(waypoints, function()
            notify("Auto Play · terminé", 1.5)
        end)
        notify("Auto Play · " .. (side == 1 and "LEFT" or "RIGHT"), 1.8)
        saveConfig()
    end

    ToggleStates.__on(autoLeftRow,  function(state)
        if SpeedSystem.autoPlayMode == "1btn" then return end
        SpeedSystem.AutoPath.set("left", state)
        saveConfig()
    end)
    ToggleStates.__on(autoRightRow, function(state)
        if SpeedSystem.autoPlayMode == "1btn" then return end
        SpeedSystem.AutoPath.set("right", state)
        saveConfig()
    end)
    ToggleStates.__on(autoPlay1Row, function(state)
        if SpeedSystem.autoPlayMode ~= "1btn" then return end
        SpeedSystem.AutoPath.setYusf(state)
        saveConfig()
    end)

    UserInputService.InputBegan:Connect(function(input, gp)
        if gp then return end
        if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
        local kb = SpeedSystem.keybinds
        -- AutoPlay key (1btn)
        if kb.AutoPlay and input.KeyCode == kb.AutoPlay then
            if SpeedSystem.autoPlayMode == "1btn" then
                local blocked = SpeedSystem:isActionBlocked("autoplay")
                if blocked and not SpeedSystem.autoPlayEnabled then
                    notify("Safe Mode LOCK", 1.6)
                else
                    SpeedSystem.AutoPath.setYusf(not SpeedSystem.autoPlayEnabled)
                    saveConfig(true)
                end
            end
            return
        end
        if SpeedSystem.autoPlayMode == "1btn" then
            -- AutoLeft/Right also toggle 1btn if set
            if kb.AutoLeft and input.KeyCode == kb.AutoLeft then
                SpeedSystem.AutoPath.setYusf(not SpeedSystem.autoPlayEnabled)
                saveConfig(true)
            elseif kb.AutoRight and input.KeyCode == kb.AutoRight then
                SpeedSystem.AutoPath.setYusf(not SpeedSystem.autoPlayEnabled)
                saveConfig(true)
            end
        else
            if kb.AutoLeft and input.KeyCode == kb.AutoLeft then
                SpeedSystem.AutoPath.set("left", not SpeedSystem.AutoPath.leftEnabled)
            elseif kb.AutoRight and input.KeyCode == kb.AutoRight then
                SpeedSystem.AutoPath.set("right", not SpeedSystem.AutoPath.rightEnabled)
            end
        end
    end)

    LP.CharacterAdded:Connect(function()
        SpeedSystem.AutoPath.stop("left"); SpeedSystem.AutoPath.stop("right")
        SpeedSystem.autoPlayEnabled = false
        setRowVisual(autoPlay1Row, false)
    end)

    _G.NoxaAutoPlayRows = {
        left = autoLeftRow, right = autoRightRow, one = autoPlay1Row,
        applyModeVisibility = applyModeVisibility,
    }
end -- AUTO PLAY block



