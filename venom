    local click = new("TextButton", {
        Name = "ToggleClick", ZIndex = 100,
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1, Text = "",
        AutoButtonColor = false, Parent = area,
    })

    FX.ripple(click)
    ToggleStates[r] = startOn or false
    click.MouseButton1Click:Connect(function()
        -- anim clic toggle
        pcall(function()
            local sc = track:FindFirstChild("ClickScale") or Instance.new("UIScale")
            sc.Name = "ClickScale"
            sc.Scale = 1
            sc.Parent = track
            TweenService:Create(sc, TweenInfo.new(0.07, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Scale = 0.86}):Play()
            task.delay(0.07, function()
                TweenService:Create(sc, TweenInfo.new(0.12, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1}):Play()
            end)
        end)
        ToggleStates[r] = not ToggleStates[r]
        setToggleVisual(track, knob, ToggleStates[r])
        local state = ToggleStates[r]
        local cbs = ToggleStates.__cbs[r]
        if cbs then
            for _, cb in ipairs(cbs) do
                pcall(cb, state)
            end
        end
    end)

    if keyBadge then
        local bindName = nil
        if label:match("Carry") then bindName = "Carry"
        elseif label:match("Lagger") then bindName = "Lagger"
        elseif label:match("Auto Left") then bindName = "AutoLeft"
